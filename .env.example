# ── Required ────────────────────────────────────────────────────────────────
# Get a free key (250 searches/month) at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# ── Optional: LLM (any OpenAI-compatible provider) ──────────────────────────
# Kasauti works WITHOUT an LLM (rule-based mode), but verdicts are richer with one.
# Auto-detected keys, in priority order:
#   OPENAI_API_KEY      → gpt-4o-mini
#   GEMINI_API_KEY      → gemini-2.5-flash        (free tier available in India)
#   ANTHROPIC_API_KEY   → claude-haiku-4-5
#   GROQ_API_KEY        → llama-3.3-70b-versatile (free tier)
# Or run fully local & free with Ollama:  KASAUTI_OLLAMA_MODEL=llama3.2

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# KASAUTI_OLLAMA_MODEL=

# Explicit override (wins over auto-detection):
# KASAUTI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# KASAUTI_LLM_API_KEY=
# KASAUTI_LLM_MODEL=gemini-2.5-flash

# Gemini "thinking" mode is OFF by default (none) — it adds 30–60s/call with
# no accuracy gain for this task. Set low/medium/high to re-enable if you want.
# KASAUTI_GEMINI_THINKING=none
# KASAUTI_LLM_TIMEOUT=45

# ── Optional: tuning ─────────────────────────────────────────────────────────
# Max claims to verify per forward (each claim ≈ 3 SerpApi searches). Default 2.
# KASAUTI_MAX_CLAIMS=2

# Cache SerpApi responses on disk to save credits during development (hours).
# Default 22. Set 0 to disable.
# KASAUTI_CACHE_TTL_HOURS=22

# Offline demo mode: serve bundled fixture responses, zero API calls.
# For development/tests only — never for a real verification.
# KASAUTI_OFFLINE=0
